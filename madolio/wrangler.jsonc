{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madolio",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "madolio.com.br", "custom_domain": true },
    { "pattern": "www.madolio.com.br", "custom_domain": true }
  ]
}
