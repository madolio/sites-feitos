{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madolio-admin",
  "compatibility_date": "2026-09-16",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madolio-metricas",
      "database_id": "024d9eb3-7a83-464d-ae4f-5b8ddae867e4"
    }
  ]
}
